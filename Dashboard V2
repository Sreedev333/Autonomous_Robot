// ---------- ULTRASONIC READER (RETAINED) ----------
long readUltrasonicCM(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH, 30000);
  if (duration == 0) return -1;
  long cm = duration / 29 / 2;
  return cm;
}

// ---------- SETUP (RETAINED) ----------
void setup() {
  Serial.begin(115200);
  delay(200);

  // Initialize OLED Display
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
  } else {
    Serial.println("Display OK");
    display.clearDisplay();
    display.setTextSize(2);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0, 20);
    display.println("BOOTING...");
    display.display();
  }

  // Ultrasonic
  for (int i = 0; i < 5; ++i) {
    pinMode(usPins[i].trig, OUTPUT);
    pinMode(usPins[i].echo, INPUT);
    digitalWrite(usPins[i].trig, LOW);
  }

  // I2C for BNO055
  Wire.begin(21, 22);
  if (!bno.begin()) {
    Serial.println("BNO055 not found!");
  } else {
    bno.setExtCrystalUse(true);
    Serial.println("BNO055 OK");
  }

  // GPS
  GPSSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  Serial.println("GPS started at 9600 baud");

  // Lidar
  LidarSerial.begin(115200, SERIAL_8N1, LIDAR_RX_PIN, LIDAR_TX_PIN);
  Serial.println("Lidar started at 115200 baud");

  // WiFi
  WiFi.mode(WIFI_STA);
  
  // Set custom MAC address
  esp_err_t ret = esp_wifi_set_mac(WIFI_IF_STA, &newMACAddress[0]);
  if (ret == ESP_OK) {
    Serial.print("MAC Address set to: ");
    for(int i = 0; i < 6; i++) {
      Serial.printf("%02X", newMACAddress[i]);
      if(i < 5) Serial.print(":");
    }
    Serial.println();
  } else {
    Serial.println("Failed to set MAC address");
  }
  
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("Connecting to WiFi...");
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println("WiFi");
  display.println("Connecting...");
  display.display();
  
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(400);
    Serial.print(".");
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi Connected!");
    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());
    
    currentMacAddress = getMacAddress();
    Serial.print("Active MAC Address: ");
    Serial.println(currentMacAddress);
    
    updateDisplay();
  } else {
    Serial.println("\nWiFi Connection Failed");
    display.clearDisplay();
    display.setTextSize(1);
    display.setCursor(0, 20);
    display.println("WiFi FAILED");
    display.display();
  }

  // Web server
  server.on("/", handleRoot);
  server.on("/sensors", handleSensorsJSON);
  server.on("/setcam", handleSetCam);
  server.begin();
  Serial.println("Web Server Started");
  Serial.print("Access dashboard at: http://");
  Serial.println(WiFi.localIP());
}

// ---------- LOOP (RETAINED) ----------
unsigned long lastSensorTime = 0;
unsigned long lastDisplayUpdate = 0;

void loop() {
  server.handleClient();

  // GPS
  while (GPSSerial.available() > 0) {
    gps.encode(GPSSerial.read());
  }
  if (gps.location.isValid()) {
    gpsLat = gps.location.lat();
    gpsLng = gps.location.lng();
  } else {
    gpsLat = 0.0;
    gpsLng = 0.0;
  }

  // BNO055 Orientation
  sensors_event_t event;
  bno.getEvent(&event, Adafruit_BNO055::VECTOR_EULER);
  bnoHeading = event.orientation.x;
  bnoPitch   = event.orientation.y;
  bnoRoll    = event.orientation.z;

  // BNO055 Accelerometer (Populating global variables)
  sensors_event_t accel_event;
  bno.getEvent(&accel_event, Adafruit_BNO055::VECTOR_LINEARACCEL);
  bnoAccelX = accel_event.acceleration.x;
  bnoAccelY = accel_event.acceleration.y;
  bnoAccelZ = accel_event.acceleration.z;

  // LIDAR
  long ld = parseLD20Frame();
  if (ld > 0) lidarDistance = ld;

  // Ultrasonic every 300ms
  if (millis() - lastSensorTime > 300) {
    lastSensorTime = millis();
    for (int i = 0; i < 5; ++i) {
      long d = readUltrasonicCM(usPins[i].trig, usPins[i].echo);
      usDistances[i] = (d <= 0 || d > 400) ? 0 : d; 
    }
  }
  
  // Update display every 5 seconds
  if (millis() - lastDisplayUpdate > 5000) {
    lastDisplayUpdate = millis();
    updateDisplay();
  }
}
