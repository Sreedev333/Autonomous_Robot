// ---------- DISPLAY UPDATE FUNCTION ----------
void updateDisplay() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  
  display.setCursor(0, 0);
  display.print("SSID:");
  display.println(WIFI_SSID);
  
  display.setCursor(0, 12);
  display.print("PWD:");
  display.println(WIFI_PASS);
  
  display.setCursor(0, 24);
  display.print("IP:");
  if (WiFi.status() == WL_CONNECTED) {
    display.println(WiFi.localIP());
  } else {
    display.println("Connecting...");
  }
  
  display.setCursor(0, 36);
  display.print("MAC:");
  display.setCursor(0, 48);
  display.println(currentMacAddress);
  
  display.display();
}

// ---------- GET MAC ADDRESS AS STRING ----------
String getMacAddress() {
  uint8_t mac[6];
  WiFi.macAddress(mac);
  char macStr[18];
  sprintf(macStr, "%02X:%02X:%02X:%02X:%02X:%02X", 
          mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
  return String(macStr);
}

// ---------- LIDAR PARSER ----------
long parseLD20Frame() {
  if (LidarSerial.available() < 47) return -1;
  
  static uint8_t buffer[47];
  static int idx = 0;
  
  while (LidarSerial.available()) {
    uint8_t byte = LidarSerial.read();
    lidarBytesReceived++;
    
    if (idx == 0) {
      if (byte == 0x54) {
        buffer[idx++] = byte;
      }
      continue;
    }
    
    if (idx == 1) {
      if (byte == 0x2C) {
        buffer[idx++] = byte;
      } else {
        idx = 0;
      }
      continue;
    }
    
    buffer[idx++] = byte;
    
    if (idx >= 47) {
      idx = 0;
      lidarValidFrames++;
      
      uint16_t dist = (buffer[5] << 8) | buffer[4];
      
      if (dist > 0 && dist < 40000) {
        return dist;
      }
    }
  }
  return -1;
}

